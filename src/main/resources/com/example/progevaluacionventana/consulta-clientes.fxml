<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550.0" prefWidth="850.0"
            style="-fx-font-family: 'Times New Roman';"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.progevaluacionventana.ConsultaClientesSources.ConsultasClientesController">

    <children>
        <VBox layoutX="30.0" layoutY="25.0"
              prefWidth="790.0" spacing="15.0">

            <Label text="Consulta Clientes"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <Separator prefWidth="790.0" />

            <HBox spacing="10.0">
                <Label text="Buscar cliente:"
                       style="-fx-font-size: 16px;" />
                <TextField fx:id="txtBuscar"
                           prefWidth="300.0"
                           promptText="Ingrese nombre del cliente" />
                <Button text="Buscar" onAction="#buscar" />
                <Button text="Actualizar" onAction="#actualizar" />
            </HBox>

            <TableView fx:id="tablaClientes"
                       onMouseClicked="#dobleClic"
                       prefHeight="330.0" prefWidth="790.0">
                <columns>
                    <TableColumn fx:id="colNombre"
                                 prefWidth="190.0"
                                 text="Nombre completo" />
                    <TableColumn fx:id="colTipoCliente"
                                 prefWidth="140.0"
                                 text="Tipo de cliente" />
                    <TableColumn fx:id="colCiudad"
                                 prefWidth="130.0"
                                 text="Ciudad" />
                    <TableColumn fx:id="colFechaNacimiento"
                                 prefWidth="150.0"
                                 text="Fecha de nacimiento" />
                    <TableColumn fx:id="colTipoSolicitud"
                                 prefWidth="160.0"
                                 text="Tipo de solicitud" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="Ver detalle"
                        prefWidth="110.0"
                        onAction="#verDetalle" />
                <Button text="Cerrar"
                        prefWidth="100.0"
                        onAction="#cerrar" />
            </HBox>

            <Label text="Haga doble clic sobre un cliente para ver sus detalles."
                   style="-fx-font-size: 13px;" />
        </VBox>
    </children>
</AnchorPane>